{
  "name": "webinspectai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "node --conditions=react-server --import tsx --test tests/*.test.ts",
    "test:accessibility": "node --conditions=react-server --import tsx --test tests/accessibility-browser.test.ts",
    "test:mobile": "node --conditions=react-server --import tsx --test tests/mobile-browser.test.ts tests/mobile-score.test.ts",
    "test:performance": "node --conditions=react-server --import tsx --test tests/performance-auditor.test.ts",
    "test:ai": "node --conditions=react-server --import tsx --test tests/ai-ui-ux.test.ts",
    "browser:install": "playwright install chromium"
  },
  "dependencies": {
    "axe-core": "^4.13.0",
    "cheerio": "^1.2.0",
    "lighthouse": "^13.5.0",
    "next": "^16.3.6",
    "openai": "^7.23.0",
    "playwright": "^1.63.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.16.11",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3"
  }
}
